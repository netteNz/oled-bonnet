# Template for .env.secrets (gitignored, chmod 600) -- copy this file to
# .env.secrets and fill in your real CDP API key. Never commit the real one.
#
# Same CDP_API_KEY / CDP_API_SECRET names used elsewhere so a key exported
# from the CDP portal drops in unchanged. CDP_API_SECRET can be either an
# Ed25519 key (base64, no PEM headers, as downloaded from the portal) or a
# legacy EC key (PEM, "-----BEGIN EC PRIVATE KEY-----..."), on one line with
# real newlines replaced by literal "\n" -- oled_hud/demos/coinbase_ticker.py
# passes the string straight to RESTClient, which detects the key type
# itself.

CDP_API_KEY=00000000-0000-0000-0000-000000000000
CDP_API_SECRET=base64-or-PEM-secret-from-the-CDP-portal
